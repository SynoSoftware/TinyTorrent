<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Synapse_Sample.TableDemoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Synapse_Sample"
    xmlns:t="using:Synapse"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="NameCell" x:DataType="local:DemoRow">
            <TextBlock Text="{x:Bind Name}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <DataTemplate x:Key="SizeCell" x:DataType="local:DemoRow">
            <TextBlock Text="{x:Bind SizeText}"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap" />
        </DataTemplate>

        <DataTemplate x:Key="AddedCell" x:DataType="local:DemoRow">
            <TextBlock Text="{x:Bind AddedText}"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <DataTemplate x:Key="ProgressCell" x:DataType="local:DemoRow">
            <Grid VerticalAlignment="Center" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             Minimum="0"
                             Maximum="100"
                             Value="{x:Bind Progress}"
                             VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ProgressText}"
                           MinWidth="34"
                           TextAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ActionCell" x:DataType="local:DemoRow">
            <Button Content="Details"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="OnDetailsClick" />
        </DataTemplate>
    </Page.Resources>

    <Grid RowSpacing="8" Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock x:Name="Caption"
                       Text="Downloads"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="Status"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <t:TableView x:Name="Table"
                     Grid.Row="1"
                     AutomationProperties.Name="Downloads"
                     Background="{ThemeResource LayerFillColorDefaultBrush}"
                     BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                     BorderThickness="1">
            <t:TableView.Columns>
                <t:TableColumn DisplayName="Name"
                               Width="420"
                               MinWidth="160"
                               CellTemplate="{StaticResource NameCell}" />
                <t:TableColumn DisplayName="Size"
                               Width="150"
                               MinWidth="90"
                               CellAlignment="Right"
                               CellTemplate="{StaticResource SizeCell}" />
                <t:TableColumn DisplayName="Added"
                               Width="220"
                               MinWidth="140"
                               CellTemplate="{StaticResource AddedCell}" />
                <!-- A bar has to fill its column, so this cell is stretched, not left-aligned. -->
                <t:TableColumn DisplayName="Progress"
                               Width="320"
                               MinWidth="160"
                               CellAlignment="Stretch"
                               CellTemplate="{StaticResource ProgressCell}" />
                <t:TableColumn DisplayName="Action"
                               Width="170"
                               MinWidth="120"
                               CellTemplate="{StaticResource ActionCell}" />
            </t:TableView.Columns>
        </t:TableView>
    </Grid>
</Page>
