<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Synapse_Sample.TableDemoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Synapse_Sample"
    xmlns:t="using:Synapse"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <!--
            Cell spacing is the host's decision, so every template carries its own padding and
            this implicit style gives the header cells the matching inset.
        -->
        <Style TargetType="t:TableHeaderCell">
            <Setter Property="Padding" Value="12,6,12,6" />
        </Style>

        <DataTemplate x:Key="NameCell" x:DataType="local:DemoRow">
            <TextBlock Text="{x:Bind Name}"
                       Margin="12,0"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <DataTemplate x:Key="SizeCell" x:DataType="local:DemoRow">
            <TextBlock Text="{x:Bind SizeText}"
                       Margin="12,0"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap" />
        </DataTemplate>

        <DataTemplate x:Key="AddedCell" x:DataType="local:DemoRow">
            <TextBlock Text="{x:Bind AddedText}"
                       Margin="12,0"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <DataTemplate x:Key="ProgressCell" x:DataType="local:DemoRow">
            <Grid Margin="12,0" VerticalAlignment="Center" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             Minimum="0"
                             Maximum="100"
                             Value="{x:Bind Progress}"
                             VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{x:Bind ProgressText}"
                           MinWidth="34"
                           TextAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ActionCell" x:DataType="local:DemoRow">
            <Button Content="Details"
                    Margin="12,4"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="OnDetailsClick" />
        </DataTemplate>
    </Page.Resources>

    <Grid RowSpacing="8" Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock x:Name="Caption"
                       Text="Downloads"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="Status"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <t:TableView x:Name="Table"
                     Grid.Row="1"
                     AutomationProperties.Name="Downloads"
                     Background="{ThemeResource LayerFillColorDefaultBrush}"
                     BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                     BorderThickness="1">
            <t:TableView.Columns>
                <t:TableColumn Id="name"
                               DisplayName="Name"
                               DefaultWidth="420"
                               MinWidth="160"
                               CellTemplate="{StaticResource NameCell}" />
                <t:TableColumn Id="size"
                               DisplayName="Size"
                               DefaultWidth="150"
                               MinWidth="90"
                               CellHorizontalAlignment="Right"
                               CellTemplate="{StaticResource SizeCell}" />
                <t:TableColumn Id="added"
                               DisplayName="Added"
                               DefaultWidth="220"
                               MinWidth="140"
                               CellTemplate="{StaticResource AddedCell}" />
                <!-- A bar has to fill its column, so this cell is stretched, not left-aligned. -->
                <t:TableColumn Id="progress"
                               DisplayName="Progress"
                               DefaultWidth="320"
                               MinWidth="160"
                               CellHorizontalAlignment="Stretch"
                               CellTemplate="{StaticResource ProgressCell}" />
                <t:TableColumn Id="action"
                               DisplayName="Action"
                               DefaultWidth="170"
                               MinWidth="120"
                               CellTemplate="{StaticResource ActionCell}" />
            </t:TableView.Columns>
        </t:TableView>
    </Grid>
</Page>
