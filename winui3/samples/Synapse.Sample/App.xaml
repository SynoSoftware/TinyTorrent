<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Synapse_Sample.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Synapse_Sample">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>

            <!--
                The row menu's focus visual. The platform default is a two-tone rectangle, a thick
                near-black stroke with a thin near-white one inside it, drawn that way so it stays
                visible over anything. Around a menu item on this page it reads as a hard box
                belonging to no part of the design. The outer stroke is dropped here and what is
                left is the accent, which still says where the keyboard is without framing the item.

                Scoped to MenuFlyoutItem on purpose. An earlier version of this overrode
                FocusStrokeColorOuterBrush and FocusStrokeColorInnerBrush for the whole application,
                which was wrong twice over: it changed focus on every button and text box here to
                fix a menu, and those two brushes are not only focus strokes. Synapse's own
                Generic.xaml uses them as fills for section 11's column drop marker, section 16's
                row drop marker and section 15's marquee, so the override quietly turned three
                specified cues from a two-tone pair into one tone.

                The brushes below are declared in ThemeDictionaries because a ThemeResource lookup
                searches those first; the same keys as plain application resources are found after
                the merged WinUI ones and never take effect. High contrast keeps the platform's own
                pair: the accent measures 1.00:1 in contrast themes, which is the case the two-tone
                pair exists for.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="MenuItemFocusOuterBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="MenuItemFocusInnerBrush"
                                     Color="{ThemeResource SystemAccentColorLight2}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="MenuItemFocusOuterBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="MenuItemFocusInnerBrush"
                                     Color="{ThemeResource SystemAccentColorDark1}" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="MenuItemFocusOuterBrush" ResourceKey="FocusStrokeColorOuterBrush" />
                    <StaticResource x:Key="MenuItemFocusInnerBrush" ResourceKey="FocusStrokeColorInnerBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                Three styles, not one. A XAML implicit style keys on the exact runtime type, and the
                header menu builds all three: MenuFlyoutItem for its commands, ToggleMenuFlyoutItem
                for each column's visibility, and MenuFlyoutSubItem for the Columns row that opens
                them. Styling only the first leaves the platform's box on the column list, which is
                the part of that menu a keyboard reaches for most.
            -->
            <Style TargetType="MenuFlyoutItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource MenuItemFocusOuterBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource MenuItemFocusInnerBrush}" />
            </Style>

            <Style TargetType="ToggleMenuFlyoutItem" BasedOn="{StaticResource DefaultToggleMenuFlyoutItemStyle}">
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource MenuItemFocusOuterBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource MenuItemFocusInnerBrush}" />
            </Style>

            <Style TargetType="MenuFlyoutSubItem" BasedOn="{StaticResource DefaultMenuFlyoutSubItemStyle}">
                <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource MenuItemFocusOuterBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource MenuItemFocusInnerBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
