<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Must match the app projects. They declare x86;x64;ARM64 and have no AnyCPU, so a
         solution defaulting to AnyCPU cannot map onto them. -->
    <Platforms>x86;x64;ARM64</Platforms>
    <RootNamespace>TinyTorrent_Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TinyTorrent.Core\TinyTorrent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The daemon fake, shared rather than copied. It is an HttpMessageHandler, so it drives the
         session's whole poll loop with no socket; a second copy here would be a second thing to
         keep in step with the client's header handling and 409 replay. -->
    <Compile Include="..\Transmission.Tests\FakeDaemon.cs" Link="FakeDaemon.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shipping page's own XAML. ColumnProfileTests reads the file the application declares
         its columns in, rather than a copy of it that can agree with the appendix while the page
         disagrees with both. -->
    <Content Include="..\..\src\TinyTorrent.Ui\Torrent\TorrentPage.xaml"
             Link="TorrentPage.xaml"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
  </ItemGroup>
</Project>
