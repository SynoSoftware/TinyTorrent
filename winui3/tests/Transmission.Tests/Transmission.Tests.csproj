<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Must match the app projects. They declare x86;x64;ARM64 and have no AnyCPU, so a
         solution defaulting to AnyCPU cannot map onto them. -->
    <Platforms>x86;x64;ARM64</Platforms>
    <RootNamespace>Transmission_Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Transmission\Transmission.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Captured with a JSON-RPC 2.0 POST against transmission-daemon 4.1.1, so decoding is
         tested against what the daemon actually sends rather than what the spec says it does. -->
    <Content Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
