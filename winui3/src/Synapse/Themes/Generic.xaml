<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Synapse"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <!-- Shared column geometry needs exactly these two container values. -->
    <Style x:Key="SynapseTableRowContainerStyle"
           TargetType="ListViewItem"
           BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <!-- Rows sit edge to edge, so a rounded corner lands on the seam with the row above. -->
        <Setter Property="CornerRadius" Value="0" />
        <!--
            No focus rectangle on a row. The owner rejected it repeatedly and finally ruled it out
            outright, and it could not be fixed by correcting who asks for focus: the framework
            rescues focus from a container it is destroying and carries that container's own
            FocusState to whatever it lands on (CControl::LeaveImpl). Once any row holds
            FocusState.Keyboard, every reconcile hands it to the next row, or out of the table
            entirely — the ring the owner saw on the host's Clear button. Only Keyboard draws a
            ring (CFocusManager::GetFocusTarget gates on IsKeyboardFocused), and no resource can
            reach that gate, so this setter is the one thing that does stop it.

            The cost, stated so nobody rediscovers it as a bug: a keyboard user moving with
            Ctrl+Arrow, which changes the current row without selecting it, now has no visual for
            where they are. Plain Arrow navigation still selects as it moves, so the accent bar
            shows it. Section 19 wants a focus indicator; this is a deliberate exception, not an
            oversight.
        -->
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <DataTemplate x:Key="SynapseTableRowTemplate">
        <local:TableRowVisual>
            <local:TableCellsPanel />
        </local:TableRowVisual>
    </DataTemplate>

    <!--
        The background of a selected row is the container's, and only the container's: two fills is
        what the owner saw as two backgrounds. The accent bar is this control's, because the
        container does not draw one here. ListViewItemSelectionIndicatorVisualEnabled is True in the
        theme, but the presenter draws that indicator for its single-selection presentation, and the
        table's list is SelectionMode="Multiple" with the check box disabled. Captured from the
        running host with two rows selected: a faint fill and no bar. The bar is also the half of the
        cue that carries contrast — the container's fill alone measures 1.08:1 in Light and 1.18:1
        in Dark against section 19's 3:1.

        Current draws nothing, in WinUI and here alike. Focus is the container's own visual.
    -->
    <Style TargetType="local:TableRowVisual">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TableRowVisual">
                    <Grid x:Name="Root">
                        <!--
                            Full row height, square, and no inset. Every one of those follows from
                            the rows sitting edge to edge, which is also why the container is
                            CornerRadius="0": an inset bar with its own corner radius leaves a gap
                            at each row seam, so a run of selected rows reads as separate marks
                            instead of one block. The width and the brush are the platform's own
                            indicator values, not chosen here.
                        -->
                        <!--
                            Focus, as a fill rather than a frame. The platform's focus visual is a
                            rectangle drawn around the element, and around a full-width row that
                            reads as a box laid over the design. The owner asked for a
                            semi-transparent background instead, so the container's own visual is
                            switched off and this takes its place. It sits under the accent bar, so
                            a row that is both focused and selected shows both.
                        -->
                        <Border x:Name="FocusFill"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Opacity="0" />
                        <Rectangle x:Name="SelectedBar"
                                   Width="3"
                                   HorizontalAlignment="Left"
                                   Fill="{ThemeResource ListViewItemSelectionIndicatorBrush}"
                                   Opacity="0" />
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="RowEmphasis">
                                <VisualState x:Name="Rest" />
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="SelectedBar.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="RowFocus">
                                <VisualState x:Name="RowUnfocused" />
                                <VisualState x:Name="RowFocused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusFill.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <!-- Section 16: the moving packet stays identifiable, in the same
                                 treatment the platform gives a dragged list item and section 11
                                 gives a dragged header. -->
                            <VisualStateGroup x:Name="DragStates">
                                <VisualState x:Name="NotDragging" />
                                <VisualState x:Name="Dragging">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity"
                                                Value="{ThemeResource ListViewItemDragThemeOpacity}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:TableHeaderCell">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <!--
            No table-owned padding. The row container is Padding="0" because shared column
            geometry requires it, so the inset inside a column belongs to the host's cell
            templates. The host sets the matching header inset with an implicit
            Style TargetType="local:TableHeaderCell" that sets Padding.
        -->
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <!--
            Without a brush the cell's empty space is not hit-testable, so a press beside the label
            reaches the strip's background instead and starts neither section 11's drag nor a sort.
        -->
        <Setter Property="Background" Value="Transparent" />
        <!-- The visible half of section 10's resize separator. The strip's grab zone is wider. -->
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TableHeaderCell">
                    <Grid x:Name="Root"
                          Background="{TemplateBinding Background}"
                          Padding="{TemplateBinding Padding}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentPresenter x:Name="PART_Header"
                                          Grid.Column="0"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />

                        <!--
                            Section 9's direction glyph on the active header. The state itself is
                            on the cell as AutomationProperties.ItemStatus, so the glyph is a
                            decoration the automation tree does not need to repeat.
                        -->
                        <FontIcon x:Name="PART_SortGlyph"
                                  Grid.Column="1"
                                  Margin="4,0,0,0"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="12"
                                  Glyph="&#xE70E;"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.AccessibilityView="Raw"
                                  Visibility="Collapsed" />

                        <VisualStateManager.VisualStateGroups>
                            <!-- Section 11: the dragged header stays identifiable, in the same
                                 treatment the platform gives a dragged list item. -->
                            <VisualStateGroup x:Name="DragStates">
                                <VisualState x:Name="NotDragging" />
                                <VisualState x:Name="Dragging">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity"
                                                Value="{ThemeResource ListViewItemDragThemeOpacity}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:TableHeaderStrip">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="TabNavigation" Value="Once" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TableHeaderStrip">
                    <Border x:Name="PART_Clip"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <local:TableCellsPanel x:Name="PART_HeaderPanel" />

                            <!--
                                Fit every column, offered in the strip's trailing space. Opt-in:
                                the table adds no visible command to a host's header unless asked,
                                and a host that already has its own fit button would otherwise
                                show two. The strip collapses it whenever the columns reach far
                                enough right to need that space, so it is only ever where nothing
                                else wants to be.

                                Subtle style, not accent: this sits in the header's own surface
                                and must not read as louder than the column labels beside it.
                            -->
                            <Button x:Name="PART_FitAllColumns"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Padding="8,0"
                                    MinWidth="0"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Visibility="Collapsed">
                                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          Glyph="&#xE9A6;"
                                          FontSize="14"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Button>

                            <!--
                                Section 11's insertion marker, positioned by the strip on the
                                boundary a drop would use. Two-tone in the platform's own focus
                                stroke pair, which measures above 3:1 in every contrast theme, and
                                the wider cap at the leading end is section 19's positional cue so
                                the destination does not depend on colour.
                            -->
                            <Grid x:Name="PART_ColumnInsertionMarker"
                                  Width="9"
                                  HorizontalAlignment="Left"
                                  IsHitTestVisible="False"
                                  AutomationProperties.AccessibilityView="Raw"
                                  Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Rectangle Grid.Row="0" Width="9" Height="5"
                                           HorizontalAlignment="Center" VerticalAlignment="Top"
                                           Fill="{ThemeResource FocusStrokeColorInnerBrush}" />
                                <Rectangle Grid.Row="0" Width="7" Height="3"
                                           HorizontalAlignment="Center" VerticalAlignment="Top"
                                           Margin="0,1,0,0"
                                           Fill="{ThemeResource FocusStrokeColorOuterBrush}" />

                                <Rectangle Grid.Row="1" Width="3"
                                           HorizontalAlignment="Center"
                                           Fill="{ThemeResource FocusStrokeColorInnerBrush}" />
                                <Rectangle Grid.Row="1" Width="1"
                                           HorizontalAlignment="Center"
                                           Fill="{ThemeResource FocusStrokeColorOuterBrush}" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:TableView">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TableView">
                    <Grid x:Name="PART_Root"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <local:TableHeaderStrip x:Name="PART_HeaderStrip" Grid.Row="0" />

                        <Grid Grid.Row="1">
                            <ListView x:Name="PART_ItemsView"
                                      Padding="0"
                                      SelectionMode="Multiple"
                                      IsMultiSelectCheckBoxEnabled="False"
                                      IsItemClickEnabled="False"
                                      ItemContainerStyle="{StaticResource SynapseTableRowContainerStyle}"
                                      ItemTemplate="{StaticResource SynapseTableRowTemplate}"
                                      ScrollViewer.HorizontalScrollMode="Disabled"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollMode="Enabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <!--
                                    No ItemContainerTransitions here on purpose: the platform's
                                    default set is what the rows animate with. Entrance, content,
                                    add/delete and reorder are all wanted, and the view never
                                    resets, so none of them replays over rows that did not change.
                                -->
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!--
                                            Half a viewport of rows realized beyond the visible
                                            ones, not the default four viewports. Measured with the
                                            torrent host: 77 containers realized for 17 rows on
                                            screen at the default, 36 at one viewport. Every
                                            realized row is bound to its item and pays for each
                                            update the source sends, whether it is on screen or not.
                                        -->
                                        <ItemsStackPanel Orientation="Vertical" CacheLength="0.5" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                            </ListView>

                            <ContentPresenter x:Name="PART_StateLayer"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              Visibility="Collapsed" />

                            <!--
                                Section 14's rectangle, sized and positioned by the gesture over
                                the row surface. Stroke only: no platform brush survives a contrast
                                theme as a translucent fill.
                            -->
                            <Grid x:Name="PART_MarqueeOverlay"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  IsHitTestVisible="False"
                                  AutomationProperties.AccessibilityView="Raw"
                                  Visibility="Collapsed">
                                <Rectangle Stroke="{ThemeResource FocusStrokeColorInnerBrush}"
                                           StrokeThickness="3" />
                                <Rectangle Stroke="{ThemeResource FocusStrokeColorOuterBrush}"
                                           StrokeThickness="1" />
                            </Grid>

                            <!--
                                Section 16's insertion marker, positioned by the drag on the
                                boundary a drop would use. It is section 11's column marker turned
                                on its side, in the same platform focus stroke pair, so the two
                                boundaries read alike and the wider cap at the leading end is
                                section 19's positional cue.
                            -->
                            <Grid x:Name="PART_RowInsertionMarker"
                                  Height="9"
                                  VerticalAlignment="Top"
                                  IsHitTestVisible="False"
                                  AutomationProperties.AccessibilityView="Raw"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Rectangle Grid.Column="0" Width="5" Height="9"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Fill="{ThemeResource FocusStrokeColorInnerBrush}" />
                                <Rectangle Grid.Column="0" Width="3" Height="7"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Margin="1,0,0,0"
                                           Fill="{ThemeResource FocusStrokeColorOuterBrush}" />

                                <Rectangle Grid.Column="1" Height="3"
                                           VerticalAlignment="Center"
                                           Fill="{ThemeResource FocusStrokeColorInnerBrush}" />
                                <Rectangle Grid.Column="1" Height="1"
                                           VerticalAlignment="Center"
                                           Fill="{ThemeResource FocusStrokeColorOuterBrush}" />
                            </Grid>
                        </Grid>

                        <primitives:ScrollBar x:Name="PART_HorizontalScrollBar"
                                              Grid.Row="2"
                                              Orientation="Horizontal"
                                              Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
