<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TinyTorrent_Ui.TorrentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TinyTorrent_Ui"
    xmlns:tt="using:TinyTorrent"
    xmlns:t="using:Synapse"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    mc:Ignorable="d">

    <Page.Resources>
        <local:ThemeBrush x:Key="ThemeBrush" />

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- ==================================================== name -->
        <DataTemplate x:Key="NameCell" x:DataType="tt:Torrent">
            <Grid VerticalAlignment="Center"
                  ColumnSpacing="6"
                  Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- x:Load: one row in 173 carries an error, so only those rows build the icon. -->
                <FontIcon x:Name="ErrorIcon"
                          x:Load="{x:Bind HasError, Mode=OneWay}"
                          Grid.Column="0"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE783;"
                          FontSize="14"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                          AutomationProperties.Name="Error">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{x:Bind ErrorString, Mode=OneWay}" />
                    </ToolTipService.ToolTip>
                </FontIcon>

                <!--
                    Every tooltip in these templates is a ToolTip element, never a bound string. A
                    string re-registers with ToolTipService on every rebind and every change; an
                    element takes new text as one property set. Measured on a re-list of 17 rows:
                    the name cell cost 64 ms with a string tooltip, the peers cell under 1 ms with
                    an element.
                -->
                <TextBlock Grid.Column="1"
                           Style="{StaticResource CellText}"
                           Text="{x:Bind Name, Mode=OneWay}">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{x:Bind NameTooltip, Mode=OneWay}" />
                    </ToolTipService.ToolTip>
                </TextBlock>

                <!-- x:Load: two rows carry a ghost label, so only those rows build the badge. -->
                <Border x:Name="GhostBadge"
                        x:Load="{x:Bind HasGhostLabel, Mode=OneWay}"
                        Grid.Column="2"
                        Padding="6,1"
                        CornerRadius="3"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                    <TextBlock Text="{x:Bind GhostLabel, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ================================================ progress -->
        <DataTemplate x:Key="ProgressCell" x:DataType="tt:Torrent">
            <Grid VerticalAlignment="Center" RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ProgressBar Grid.Row="0"
                             Minimum="0"
                             Maximum="100"
                             Height="4"
                             Value="{x:Bind ProgressPercent, Mode=OneWay}" />

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ProgressText, Mode=OneWay}"
                               FontSize="11.5" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource CellText}"
                               Text="{x:Bind TransferredText, Mode=OneWay}"
                               FontSize="11.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ================================================== status -->
        <DataTemplate x:Key="StatusCell" x:DataType="tt:Torrent">
            <!--
                A Grid, not a StackPanel: the declared 110 DIP column cannot fit every localized
                label, so the label needs a bounded column to trim inside instead of being cut.
                The full text stays available in the tooltip.
            -->
            <Border
                    Padding="7,2"
                    CornerRadius="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                <ToolTipService.ToolTip>
                    <ToolTip Content="{x:Bind StatusLabel, Mode=OneWay}" />
                </ToolTipService.ToolTip>
                <Grid ColumnSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="{x:Bind StatusGlyph, Mode=OneWay}"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Foreground="{x:Bind StatusAccentKey, Mode=OneWay, Converter={StaticResource ThemeBrush}}" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind StatusLabel, Mode=OneWay}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{x:Bind StatusAccentKey, Mode=OneWay, Converter={StaticResource ThemeBrush}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- =================================================== queue -->
        <DataTemplate x:Key="QueueCell" x:DataType="tt:Torrent">
            <TextBlock
                       Style="{StaticResource CellText}"
                       TextAlignment="Right"
                       Text="{x:Bind QueueText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </DataTemplate>

        <!-- ===================================================== eta -->
        <DataTemplate x:Key="EtaCell" x:DataType="tt:Torrent">
            <TextBlock
                       Style="{StaticResource CellText}"
                       Text="{x:Bind EtaText, Mode=OneWay}" />
        </DataTemplate>

        <!-- =================================================== speed -->
        <DataTemplate x:Key="SpeedCell" x:DataType="tt:Torrent">
            <Grid
                  VerticalAlignment="Center"
                  ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ToolTipService.ToolTip>
                    <ToolTip Content="{x:Bind SpeedTooltip, Mode=OneWay}" />
                </ToolTipService.ToolTip>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource CellText}"
                           Text="{x:Bind SpeedText, Mode=OneWay}" />

                <local:SparklineView Grid.Column="1"
                                     Width="56"
                                     Height="14"
                                     VerticalAlignment="Center"
                                     Samples="{x:Bind SpeedHistory}"
                                     Revision="{x:Bind SpeedRevision, Mode=OneWay}"
                                     Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                     AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </DataTemplate>

        <!-- =================================================== peers -->
        <DataTemplate x:Key="PeersCell" x:DataType="tt:Torrent">
            <TextBlock
                       Style="{StaticResource CellText}"
                       TextAlignment="Right"
                       Text="{x:Bind PeersText, Mode=OneWay}">
                <ToolTipService.ToolTip>
                    <ToolTip Content="{x:Bind PeersTooltip, Mode=OneWay}" />
                </ToolTipService.ToolTip>
            </TextBlock>
        </DataTemplate>

        <!-- ==================================================== size -->
        <DataTemplate x:Key="SizeCell" x:DataType="tt:Torrent">
            <TextBlock
                       Style="{StaticResource CellText}"
                       TextAlignment="Right"
                       Text="{x:Bind SizeText, Mode=OneWay}" />
        </DataTemplate>

        <!-- =================================================== ratio -->
        <DataTemplate x:Key="RatioCell" x:DataType="tt:Torrent">
            <TextBlock
                       Style="{StaticResource CellText}"
                       TextAlignment="Right"
                       Text="{x:Bind RatioText, Mode=OneWay}" />
        </DataTemplate>

        <!-- =================================================== added -->
        <DataTemplate x:Key="AddedCell" x:DataType="tt:Torrent">
            <TextBlock
                       Style="{StaticResource CellText}"
                       Text="{x:Bind AddedText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </DataTemplate>

        <!-- ============================================= completedOn -->
        <DataTemplate x:Key="CompletedOnCell" x:DataType="tt:Torrent">
            <TextBlock
                       Style="{StaticResource CellText}"
                       Text="{x:Bind CompletedOnText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </DataTemplate>

    </Page.Resources>

        <Grid x:Name="Shell" Padding="12" RowSpacing="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Torrents" VerticalAlignment="Center"
                           AutomationProperties.HeadingLevel="Level1"
                           Style="{StaticResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="Connections" Grid.Column="1" Header="Connection"
                          MinWidth="160" SelectionChanged="OnConnectionChanged"
                          AutomationProperties.Name="Connection" />
                <Button x:Name="ConnectionsButton" Grid.Column="2" Content="Connections" VerticalAlignment="Bottom"
                        Click="OnConnectionsClick" />
            </Grid>

            <CommandBar x:Name="Commands" Grid.Row="1" DefaultLabelPosition="Right" HorizontalContentAlignment="Stretch">
                <CommandBar.Content>
                    <Grid x:Name="SearchTools" SizeChanged="OnSearchLayoutChanged">
                        <Grid x:Name="SearchFields" HorizontalAlignment="Left" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <AutoSuggestBox x:Name="SearchBox" MaxWidth="220" MinWidth="{ThemeResource TextControlThemeMinWidth}" VerticalAlignment="Center"
                                            PlaceholderText="Search torrent names" QueryIcon="Find"
                                            TextChanged="OnSearchTextChanged"
                                            AutomationProperties.Name="Search torrents" />
                            <DropDownButton x:Name="FilterButton" Grid.Column="1" Content="Filter" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            SizeChanged="OnSearchLayoutChanged" ToolTipService.ToolTip="Filter torrents (Ctrl+Shift+F)"
                                            AutomationProperties.Name="Filter torrents">
                                <DropDownButton.Flyout>
                                    <MenuFlyout x:Name="Filters" Opening="OnFiltersOpening" Closed="OnFiltersClosed">
                                        <RadioMenuFlyoutItem x:Name="AllFilter" Text="All torrents" Tag="all" GroupName="TorrentFilter" Click="OnFilterClick" />
                                        <RadioMenuFlyoutItem Text="Downloading" Tag="downloading" GroupName="TorrentFilter" Click="OnFilterClick" />
                                        <RadioMenuFlyoutItem Text="Seeding" Tag="seeding" GroupName="TorrentFilter" Click="OnFilterClick" />
                                        <RadioMenuFlyoutItem Text="Paused" Tag="paused" GroupName="TorrentFilter" Click="OnFilterClick" />
                                        <RadioMenuFlyoutItem Text="Errors" Tag="error" GroupName="TorrentFilter" Click="OnFilterClick" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutSubItem x:Name="LabelsMenu" Text="Labels" />
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>
                    </Grid>
                </CommandBar.Content>
                <AppBarButton x:Name="AddButton" Label="Add" Click="OnAddClick" KeyboardAcceleratorTextOverride="Ctrl+O" />
                <AppBarButton x:Name="StartButton" Label="Start" IsEnabled="False" Click="OnStartClick" />
                <AppBarButton x:Name="PauseButton" Label="Pause" IsEnabled="False" Click="OnPauseClick" />
                <AppBarButton x:Name="RemoveButton" Label="Remove" IsEnabled="False" Click="OnRemoveClick" />
                <CommandBar.SecondaryCommands>
                    <AppBarToggleButton x:Name="DetailsButton" Label="Details" Click="OnDetailsClick" />
                    <AppBarButton x:Name="FitButton" Label="Fit columns" Click="OnFitColumnsClick" />
                    <AppBarButton x:Name="PreferencesButton" Label="Preferences" KeyboardAcceleratorTextOverride="Ctrl+,"
                                  Click="OnPreferencesClick" />
                    <AppBarButton x:Name="AppearanceButton" Label="Appearance">
                        <AppBarButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="System" Tag="Default" Click="OnThemeClick" />
                                <MenuFlyoutItem Text="Light" Tag="Light" Click="OnThemeClick" />
                                <MenuFlyoutItem Text="Dark" Tag="Dark" Click="OnThemeClick" />
                            </MenuFlyout>
                        </AppBarButton.Flyout>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <StackPanel Grid.Row="2" Spacing="8">
                <InfoBar x:Name="ConnectionNotice" IsOpen="False" IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button x:Name="RetryButton" Content="Retry" Click="OnRetryClick" AccessKey="R" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="CommandNotice" Severity="Error" Title="Action failed" IsOpen="False" />
            </StackPanel>

            <Grid x:Name="ContentArea" Grid.Row="3" SizeChanged="OnContentSizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="InspectorRow" Height="Auto" />
                </Grid.RowDefinitions>
                <t:TableView x:Name="Table"
                             AutomationProperties.Name="Torrents"
                             IsFitAllButtonEnabled="True"
                             IsRowReorderingEnabled="True"
                             LayoutChanged="OnLayoutChanged"
                             SelectionStateChanged="OnSelectionStateChanged"
                             RowContextRequested="OnRowContextRequested"
                             RowsReorderRequested="OnRowsReorderRequested">
                    <t:TableView.LoadingContent>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressRing IsActive="True" Width="32" Height="32" />
                            <TextBlock x:Name="LoadingText" Text="Connecting to the engine"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </t:TableView.LoadingContent>
                    <t:TableView.EmptyContent>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <TextBlock x:Name="EmptyHeadline" Text="No torrents yet"
                                       HorizontalAlignment="Center"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button x:Name="EmptyAddButton" Content="Add" Click="OnAddClick"
                                    ToolTipService.ToolTip="Add a torrent file or a magnet link" />
                        </StackPanel>
                    </t:TableView.EmptyContent>
                    <t:TableView.NoResultsContent>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="No matching torrents" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Button x:Name="ResetButton" Content="Reset" HorizontalAlignment="Center" Click="OnResetClick"
                                    ToolTipService.ToolTip="Show all torrents" />
                        </StackPanel>
                    </t:TableView.NoResultsContent>
            <t:TableView.Columns>
                <t:TableColumn x:Name="NameColumn"
                               Id="name"
                               DisplayName="Name"
                               Width="150"
                               MinWidth="90"
                               CellAlignment="Stretch"
                               CellTemplate="{StaticResource NameCell}" />
                <t:TableColumn x:Name="ProgressColumn"
                               Id="progress"
                               CellAlignment="Stretch"
                               DisplayName="Progress"
                               Width="220"
                               MinWidth="110"
                               CellTemplate="{StaticResource ProgressCell}" />
                <t:TableColumn x:Name="StatusColumn"
                               Id="status"
                               DisplayName="Status"
                               Width="110"
                               MinWidth="95"
                               CellTemplate="{StaticResource StatusCell}" />
                <t:TableColumn x:Name="QueueColumn"
                               Id="queue"
                               DisplayName="Queue"
                               Width="80"
                               DefinesRowOrder="True"
                               CellAlignment="Right"
                               CellTemplate="{StaticResource QueueCell}" />
                <t:TableColumn x:Name="EtaColumn"
                               Id="eta"
                               DisplayName="ETA"
                               Width="110"
                               IsVisible="False"
                               CellTemplate="{StaticResource EtaCell}" />
                <t:TableColumn x:Name="SpeedColumn"
                               Id="speed"
                               DisplayName="Speed"
                               Width="180"
                               MinWidth="160"
                               CellAlignment="Stretch"
                               CellTemplate="{StaticResource SpeedCell}" />
                <t:TableColumn x:Name="PeersColumn"
                               Id="peers"
                               DisplayName="Peers"
                               Width="88"
                               CellAlignment="Right"
                               CellTemplate="{StaticResource PeersCell}" />
                <t:TableColumn x:Name="SizeColumn"
                               Id="size"
                               DisplayName="Size"
                               Width="100"
                               CellAlignment="Right"
                               CellTemplate="{StaticResource SizeCell}" />
                <t:TableColumn x:Name="RatioColumn"
                               Id="ratio"
                               DisplayName="Ratio"
                               Width="90"
                               IsVisible="False"
                               CellAlignment="Right"
                               CellTemplate="{StaticResource RatioCell}" />
                <t:TableColumn x:Name="AddedColumn"
                               Id="added"
                               DisplayName="Added"
                               Width="100"
                               IsVisible="False"
                               CellTemplate="{StaticResource AddedCell}" />
                <t:TableColumn x:Name="CompletedOnColumn"
                               Id="completedOn"
                               DisplayName="Completed on"
                               Width="110"
                               IsVisible="False"
                               CellTemplate="{StaticResource CompletedOnCell}" />
            </t:TableView.Columns>
                </t:TableView>
                <local:DetailsSplitter x:Name="InspectorDivider" Grid.Row="1" Height="{x:Bind Shell.RowSpacing, Mode=OneTime}"
                                  Visibility="Collapsed" IsTabStop="True" UseSystemFocusVisuals="True"
                                  AutomationProperties.Name="Resize torrent details"
                                  ToolTipService.ToolTip="Drag to resize details, or use Up and Down arrows"
                                  DragDelta="OnInspectorDragDelta" KeyDown="OnInspectorKeyDown">
                    <local:DetailsSplitter.Template>
                        <ControlTemplate TargetType="local:DetailsSplitter">
                            <primitives:Thumb x:Name="PART_Thumb" IsTabStop="False" AutomationProperties.AccessibilityView="Raw">
                            <primitives:Thumb.Template>
                            <ControlTemplate TargetType="primitives:Thumb">
                            <Grid x:Name="DividerSurface" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="DividerSurface.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="DividerSurface.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0" VerticalAlignment="Center" />
                            </Grid>
                            </ControlTemplate>
                            </primitives:Thumb.Template>
                            </primitives:Thumb>
                        </ControlTemplate>
                    </local:DetailsSplitter.Template>
                </local:DetailsSplitter>
                <Grid x:Name="InspectorHost" Grid.Row="2" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Button x:Name="DetailsBack" Content="Back" ToolTipService.ToolTip="Back to torrents"
                            Visibility="Collapsed" Click="OnDetailsBack" />
                    <local:InspectorView x:Name="Inspector" Grid.Row="1" SizeChanged="OnInspectorSizeChanged" />
                </Grid>
            </Grid>

            <Grid Grid.Row="4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusLine" Text="Connecting" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           ToolTipService.ToolTip="{x:Bind StatusLine.Text, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SpaceText" Grid.Column="1" Text="Free space unavailable" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <ToolTipService.ToolTip><ToolTip x:Name="SpaceTooltip" /></ToolTipService.ToolTip>
                </TextBlock>
                <ToggleButton x:Name="AltSpeedButton" Grid.Column="2" Content="Alternative limits"
                              IsEnabled="False" Click="OnAltSpeedClick"
                              ToolTipService.ToolTip="Use the alternative download and upload limits" />
            </Grid>
        </Grid>
</Page>
