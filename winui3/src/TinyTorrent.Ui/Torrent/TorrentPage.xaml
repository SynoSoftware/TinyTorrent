<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TinyTorrent_Ui.TorrentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TinyTorrent_Ui"
    xmlns:tt="using:TinyTorrent"
    xmlns:t="using:Synapse"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:ThemeBrush x:Key="ThemeBrush" />

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- ==================================================== name -->
        <DataTemplate x:Key="NameCell" x:DataType="tt:Torrent">
            <Grid VerticalAlignment="Center"
                  ColumnSpacing="6"
                  Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- x:Load: one row in 173 carries an error, so only those rows build the icon. -->
                <FontIcon x:Name="ErrorIcon"
                          x:Load="{x:Bind HasError, Mode=OneWay}"
                          Grid.Column="0"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE783;"
                          FontSize="14"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                          AutomationProperties.Name="Error">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{x:Bind ErrorString, Mode=OneWay}" />
                    </ToolTipService.ToolTip>
                </FontIcon>

                <!--
                    Every tooltip in these templates is a ToolTip element, never a bound string. A
                    string re-registers with ToolTipService on every rebind and every change; an
                    element takes new text as one property set. Measured on a re-list of 17 rows:
                    the name cell cost 64 ms with a string tooltip, the peers cell under 1 ms with
                    an element.
                -->
                <TextBlock Grid.Column="1"
                           Style="{StaticResource CellText}"
                           Text="{x:Bind Name, Mode=OneWay}">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{x:Bind NameTooltip, Mode=OneWay}" />
                    </ToolTipService.ToolTip>
                </TextBlock>

                <!-- x:Load: two rows carry a ghost label, so only those rows build the badge. -->
                <Border x:Name="GhostBadge"
                        x:Load="{x:Bind HasGhostLabel, Mode=OneWay}"
                        Grid.Column="2"
                        Padding="6,1"
                        CornerRadius="3"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlAltFillColorSecondaryBrush}">
                    <TextBlock Text="{x:Bind GhostLabel, Mode=OneWay}"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ================================================ progress -->
        <DataTemplate x:Key="ProgressCell" x:DataType="tt:Torrent">
            <Grid VerticalAlignment="Center" RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ProgressBar Grid.Row="0"
                             Minimum="0"
                             Maximum="100"
                             Height="4"
                             Value="{x:Bind ProgressPercent, Mode=OneWay}" />

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind ProgressText, Mode=OneWay}"
                               FontSize="11.5" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource CellText}"
                               Text="{x:Bind TransferredText, Mode=OneWay}"
                               FontSize="11.5"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ================================================== status -->
        <DataTemplate x:Key="StatusCell" x:DataType="tt:Torrent">
            <!--
                A Grid, not a StackPanel: the declared 110 DIP column cannot fit every localized
                label, so the label needs a bounded column to trim inside instead of being cut.
                The full text stays available in the tooltip.
            -->
            <Border
                    Padding="7,2"
                    CornerRadius="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                <ToolTipService.ToolTip>
                    <ToolTip Content="{x:Bind StatusLabel, Mode=OneWay}" />
                </ToolTipService.ToolTip>
                <Grid ColumnSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="{x:Bind StatusGlyph, Mode=OneWay}"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Foreground="{x:Bind StatusAccentKey, Mode=OneWay, Converter={StaticResource ThemeBrush}}" />
                    <TextBlock Grid.Column="1"
                               Text="{x:Bind StatusLabel, Mode=OneWay}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{x:Bind StatusAccentKey, Mode=OneWay, Converter={StaticResource ThemeBrush}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- =================================================== queue -->
        <DataTemplate x:Key="QueueCell" x:DataType="tt:Torrent">
            <TextBlock
                       Style="{StaticResource CellText}"
                       TextAlignment="Right"
                       Text="{x:Bind QueueText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </DataTemplate>

        <!-- ===================================================== eta -->
        <DataTemplate x:Key="EtaCell" x:DataType="tt:Torrent">
            <TextBlock
                       Style="{StaticResource CellText}"
                       Text="{x:Bind EtaText, Mode=OneWay}" />
        </DataTemplate>

        <!-- =================================================== speed -->
        <DataTemplate x:Key="SpeedCell" x:DataType="tt:Torrent">
            <Grid
                  VerticalAlignment="Center"
                  ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ToolTipService.ToolTip>
                    <ToolTip Content="{x:Bind SpeedTooltip, Mode=OneWay}" />
                </ToolTipService.ToolTip>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource CellText}"
                           Text="{x:Bind SpeedText, Mode=OneWay}" />

                <local:SparklineView Grid.Column="1"
                                     Width="56"
                                     Height="14"
                                     VerticalAlignment="Center"
                                     Samples="{x:Bind SpeedHistory}"
                                     Revision="{x:Bind SpeedRevision, Mode=OneWay}"
                                     Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                     AutomationProperties.AccessibilityView="Raw" />
            </Grid>
        </DataTemplate>

        <!-- =================================================== peers -->
        <DataTemplate x:Key="PeersCell" x:DataType="tt:Torrent">
            <TextBlock
                       Style="{StaticResource CellText}"
                       TextAlignment="Right"
                       Text="{x:Bind PeersText, Mode=OneWay}">
                <ToolTipService.ToolTip>
                    <ToolTip Content="{x:Bind PeersTooltip, Mode=OneWay}" />
                </ToolTipService.ToolTip>
            </TextBlock>
        </DataTemplate>

        <!-- ==================================================== size -->
        <DataTemplate x:Key="SizeCell" x:DataType="tt:Torrent">
            <TextBlock
                       Style="{StaticResource CellText}"
                       TextAlignment="Right"
                       Text="{x:Bind SizeText, Mode=OneWay}" />
        </DataTemplate>

        <!-- =================================================== ratio -->
        <DataTemplate x:Key="RatioCell" x:DataType="tt:Torrent">
            <TextBlock
                       Style="{StaticResource CellText}"
                       TextAlignment="Right"
                       Text="{x:Bind RatioText, Mode=OneWay}" />
        </DataTemplate>

        <!-- =================================================== added -->
        <DataTemplate x:Key="AddedCell" x:DataType="tt:Torrent">
            <TextBlock
                       Style="{StaticResource CellText}"
                       Text="{x:Bind AddedText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </DataTemplate>

        <!-- ============================================= completedOn -->
        <DataTemplate x:Key="CompletedOnCell" x:DataType="tt:Torrent">
            <TextBlock
                       Style="{StaticResource CellText}"
                       Text="{x:Bind CompletedOnText, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </DataTemplate>

    </Page.Resources>

    <Grid Padding="12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- filter strip: state filter and text search are the host's, never the table's -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Torrents"
                       VerticalAlignment="Center"
                       Style="{StaticResource SubtitleTextBlockStyle}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                <ToggleButton x:Name="FilterAll"
                              Content="All"
                              Tag="all"
                              IsChecked="True"
                              Click="OnFilterClick" />
                <ToggleButton x:Name="FilterDownloading"
                              Content="Downloading"
                              Tag="downloading"
                              Click="OnFilterClick" />
                <ToggleButton x:Name="FilterSeeding"
                              Content="Seeding"
                              Tag="seeding"
                              Click="OnFilterClick" />
            </StackPanel>

            <AutoSuggestBox Grid.Column="3"
                            x:Name="SearchBox"
                            Width="260"
                            VerticalAlignment="Center"
                            PlaceholderText="Search names"
                            QueryIcon="Find"
                            TextChanged="OnSearchTextChanged"
                            AutomationProperties.Name="Search torrents" />

            <Button Grid.Column="4"
                    Content="Fit all columns"
                    VerticalAlignment="Center"
                    Click="OnFitColumnsClick"
                    ToolTipService.ToolTip="Fit every visible column to the content on screen" />

        </Grid>

        <!--
            The gestures below are the table's, and none of them announces itself on screen. A host
            that ships this table would teach them once; this sample has to teach them every time.
        -->
        <Border Grid.Row="1"
                Padding="12,8"
                CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE946;"
                          FontSize="15"
                          VerticalAlignment="Top"
                          Margin="0,1,0,0"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBlock Grid.Column="1" TextWrapping="Wrap" LineHeight="19">
                    <Run FontWeight="SemiBold">Fit one column</Run>
                    <Run>— double-click the line between two headers, or right-click a header.</Run>
                    <LineBreak />
                    <Run FontWeight="SemiBold">Fit every column</Run>
                    <Run>— the Fit all columns button.</Run>
                    <LineBreak />
                    <Run FontWeight="SemiBold">Reorder columns</Run>
                    <Run>— drag a header sideways onto the insertion line.</Run>
                    <LineBreak />
                    <Run FontWeight="SemiBold">Select rows</Run>
                    <Run>— click, Shift-click for a range, Ctrl-click to add one.</Run>
                    <LineBreak />
                    <Run FontWeight="SemiBold">Reorder rows</Run>
                    <Run>— drag the selection, or right-click a row for Move up and Move down. Watch the Queue column.</Run>
                </TextBlock>
            </Grid>
        </Border>

        <t:TableView x:Name="Table"
                     Grid.Row="2"
                     AutomationProperties.Name="Torrents"
                     IsFitAllButtonEnabled="True"
                     IsRowReorderingEnabled="True"
                     BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                     BorderThickness="1"
                     CornerRadius="4"
                     LayoutChanged="OnLayoutChanged"
                     SelectionStateChanged="OnSelectionStateChanged"
                     RowContextRequested="OnRowContextRequested"
                     RowsReorderRequested="OnRowsReorderRequested">

            <t:TableView.LoadingContent>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <ProgressRing IsActive="True" Width="32" Height="32" />
                    <TextBlock Text="Contacting the daemon"
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </t:TableView.LoadingContent>

            <t:TableView.EmptyContent>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="&#xE896;"
                              FontSize="28"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="No torrents yet"
                               HorizontalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Add a torrent file or a magnet link to start."
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </t:TableView.EmptyContent>

            <t:TableView.NoResultsContent>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Glyph="&#xE721;"
                              FontSize="28"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="NoResultsHeadline"
                               Text="No matching torrents"
                               HorizontalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Change the filter or clear the search box."
                               HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </t:TableView.NoResultsContent>

            <t:TableView.Columns>
                <t:TableColumn x:Name="NameColumn"
                               Id="name"
                               DisplayName="Name"
                               Width="150"
                               MinWidth="90"
                               CellAlignment="Stretch"
                               CellTemplate="{StaticResource NameCell}" />
                <t:TableColumn x:Name="ProgressColumn"
                               Id="progress"
                               CellAlignment="Stretch"
                               DisplayName="Progress"
                               Width="220"
                               MinWidth="110"
                               CellTemplate="{StaticResource ProgressCell}" />
                <t:TableColumn x:Name="StatusColumn"
                               Id="status"
                               DisplayName="Status"
                               Width="110"
                               MinWidth="95"
                               CellTemplate="{StaticResource StatusCell}" />
                <t:TableColumn x:Name="QueueColumn"
                               Id="queue"
                               DisplayName="Queue"
                               Width="80"
                               DefinesRowOrder="True"
                               CellAlignment="Right"
                               CellTemplate="{StaticResource QueueCell}" />
                <t:TableColumn x:Name="EtaColumn"
                               Id="eta"
                               DisplayName="ETA"
                               Width="110"
                               IsVisible="False"
                               CellTemplate="{StaticResource EtaCell}" />
                <t:TableColumn x:Name="SpeedColumn"
                               Id="speed"
                               DisplayName="Speed"
                               Width="180"
                               MinWidth="160"
                               CellAlignment="Stretch"
                               CellTemplate="{StaticResource SpeedCell}" />
                <t:TableColumn x:Name="PeersColumn"
                               Id="peers"
                               DisplayName="Peers"
                               Width="88"
                               CellAlignment="Right"
                               CellTemplate="{StaticResource PeersCell}" />
                <t:TableColumn x:Name="SizeColumn"
                               Id="size"
                               DisplayName="Size"
                               Width="100"
                               CellAlignment="Right"
                               CellTemplate="{StaticResource SizeCell}" />
                <t:TableColumn x:Name="RatioColumn"
                               Id="ratio"
                               DisplayName="Ratio"
                               Width="90"
                               IsVisible="False"
                               CellAlignment="Right"
                               CellTemplate="{StaticResource RatioCell}" />
                <t:TableColumn x:Name="AddedColumn"
                               Id="added"
                               DisplayName="Added"
                               Width="100"
                               IsVisible="False"
                               CellTemplate="{StaticResource AddedCell}" />
                <t:TableColumn x:Name="CompletedOnColumn"
                               Id="completedOn"
                               DisplayName="Completed on"
                               Width="110"
                               IsVisible="False"
                               CellTemplate="{StaticResource CompletedOnCell}" />
            </t:TableView.Columns>
        </t:TableView>

        <!--
            Every table event the host receives, newest first. It is the only place a negative
            result shows: a drop that changes nothing adds no line.
        -->
        <Border Grid.Row="3"
                Height="132"
                Padding="10,6"
                CornerRadius="4"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Table events"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <TextBlock Grid.Column="1"
                               x:Name="StatusLine"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <Button Grid.Column="2"
                            Content="Clear"
                            Padding="10,2"
                            Click="OnClearEventsClick" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              AutomationProperties.Name="Table events">
                    <ItemsControl ItemsSource="{x:Bind Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
